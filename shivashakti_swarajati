<div class="signature">Composed by @hamsanandi</div>

<script>
/* ═══════════════════════════════════════════════════════════════
   SWARA RENDERING ENGINE
   EN→KN: S=ಸ G=ಗ M=ಮ D=ದ N=ನಿ R=ರಿ P=ಪ
   Mandra (lowercase) → green dot below  (.mandra)
   Tāra → <t>S</t> in source → red dot above (.tara)
   ═══════════════════════════════════════════════════════════════ */

const EN_TO_KN = {
  'S':'ಸ','R':'ರಿ','G':'ಗ','M':'ಮ','P':'ಪ','D':'ದ','N':'ನಿ',
  's':'ಸ','r':'ರಿ','g':'ಗ','m':'ಮ','p':'ಪ','d':'ದ','n':'ನಿ',
  ',':',','-':'-',' ':' ','.':"."
};
function isSwaraLetter(ch){return /[SRGMPDNsrgmpdnp]/.test(ch);}
function taraWrap(h){return `<span class="tara">${h}</span>`;}
function tokenHtml(token,forKn,isTara){
  if(!token)return '';
  const letter=token[0],suffix=token.slice(1);
  const isLower=isSwaraLetter(letter)&&letter===letter.toLowerCase();
  let inner;
  if(forKn){const kn=EN_TO_KN[letter]!==undefined?EN_TO_KN[letter]:letter;inner=isLower?`<span class="mandra">${kn}</span>`:kn;}
  else{inner=isLower?`<span class="mandra">${letter}</span>`:letter;}
  const result=inner+suffix;
  return isTara?taraWrap(result):result;
}
function toHtml(text,forKn,taraSet){
  return text.trim().split(/\s+/).map((t,i)=>tokenHtml(t,forKn,taraSet&&taraSet.has(i))).join(' ');
}
function parseTd(td){
  const clone=td.cloneNode(true);
  const tokens=[];
  clone.childNodes.forEach(node=>{
    if(node.nodeType===Node.TEXT_NODE)node.textContent.trim().split(/\s+/).filter(Boolean).forEach(t=>tokens.push({t,tara:false}));
    else if(node.nodeName==='T')node.textContent.trim().split(/\s+/).filter(Boolean).forEach(t=>tokens.push({t,tara:true}));
  });
  const taraSet=new Set();tokens.forEach((item,i)=>{if(item.tara)taraSet.add(i);});
  return{text:tokens.map(item=>item.t).join(' '),taraSet};
}
function stackedCell(text,taraSet){
  return `<span class="cell-kn">${toHtml(text,true,taraSet)}</span><span class="cell-en">${toHtml(text,false,taraSet)}</span>`;
}
document.querySelectorAll('tbody tr td').forEach(td=>{
  const{text,taraSet}=parseTd(td);
  td.innerHTML=stackedCell(text,taraSet);
});
</script>
